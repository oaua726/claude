# LINE Messaging API credentials
# Get these from https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# Public base URL where this server is reachable (no trailing slash)
# LINE requires HTTPS, so use a tunnel like ngrok for local development:
#   ngrok http 8000  →  BASE_URL=https://xxxx.ngrok.io
BASE_URL=https://your-domain.com

# Port to listen on (default: 8000)
PORT=8000
